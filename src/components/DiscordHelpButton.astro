---
// DiscordHelpButton — "Get more help >" in accent color, dark text, Discord logo.
// Perplexity model ("Contact Support >"), mapped to Discord.
import { SITE_LINKS } from '../config/site';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---
<a
  class:list={['discord-help-btn', compact && 'is-compact']}
  href={SITE_LINKS.discord}
  target="_blank"
  rel="noopener noreferrer"
>
  <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
    <path d="M20.317 4.369a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.865-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.058a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .078-.01c3.928 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .079.009c.12.099.246.198.373.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.699.772 1.362 1.225 1.993a.076.076 0 0 0 .084.029 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.055c.5-5.177-.838-9.674-3.549-13.66a.06.06 0 0 0-.031-.03ZM8.02 15.33c-1.182 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418Zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418Z"/>
  </svg>
  <span>Get more help</span>
  <span aria-hidden="true" class="arrow">&gt;</span>
</a>

<style>
  .discord-help-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--sl-color-accent-high, #8aebff);
    color: #051424;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.7rem 1.2rem;
    border-radius: 0.9rem;
    text-decoration: none;
    border: 1px solid rgba(5, 20, 36, 0.2);
    /* Soft neumorphism: slightly raised, not plastic */
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.35) inset,
      0 8px 20px -8px rgba(138, 235, 255, 0.45),
      0 2px 6px -2px rgba(0, 0, 0, 0.5);
    transition: transform 0.15s ease, box-shadow 0.15s ease, filter 0.15s ease;
  }
  .discord-help-btn:hover {
    filter: brightness(1.06);
    transform: translateY(-1px);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.4) inset,
      0 12px 28px -8px rgba(138, 235, 255, 0.55),
      0 4px 10px -2px rgba(0, 0, 0, 0.5);
  }
  .discord-help-btn .arrow {
    font-weight: 800;
    margin-left: 0.1rem;
  }
  .discord-help-btn.is-compact {
    padding: 0.5rem 0.9rem;
    font-size: 0.85rem;
  }
</style>
